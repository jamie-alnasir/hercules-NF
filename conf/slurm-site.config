/* SLURM configuration. */
process {
    // queue = 'compute'         // SLURM --partition
    // clusterOptions = '--account=MY_ALLOCATION'
    withName: 'MAP_SHARD' {
        cpus = 1
        memory = '8 GB'
        time = '24h'
    }
    withName: 'ANALYSE' {
        cpus = 2
        memory = '24 GB'
        time = '12h'
    }
}

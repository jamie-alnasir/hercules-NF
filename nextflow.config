manifest {
    name = 'Hercules-NF'
    author = 'Hercules computational genomics project'
    description = 'Nextflow DSL2 reimplementation of Hercules motif-position analysis'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    sam                = null
    gtf                = null
    outdir             = 'results'
    feature            = 'CDS'
    k                  = 4
    shards             = 16
    primer_exclude     = 10
    min_mapq           = 0
    exclude_duplicates = false
    min_pairs          = 10
    outlier_count      = 10
    save_intermediates = false
}

process {
    executor = 'local'
    errorStrategy = 'terminate'
    maxRetries = 0
    withName: 'SPLIT_SAM' {
        cpus = 1
        memory = '2 GB'
        time = '8h'
    }
    withName: 'MAP_SHARD' {
        cpus = 1
        memory = '6 GB'
        time = '24h'
    }
    withName: 'GC_SUMMARY' {
        cpus = 1
        memory = '2 GB'
        time = '4h'
    }
    withName: 'MOTIF_REDUCE' {
        cpus = 1
        memory = '2 GB'
        time = '8h'
    }
    withName: 'ANALYSE' {
        cpus = 2
        memory = '12 GB'
        time = '12h'
    }
}

profiles {
    local {
        process.executor = 'local'
        process {
            withName: 'MAP_SHARD' { maxForks = 8 }
            withName: 'MOTIF_REDUCE' { maxForks = 8 }
        }
    }
    slurm {
        process.executor = 'slurm'
        process {
            withName: 'MAP_SHARD' { maxForks = 32 }
            withName: 'MOTIF_REDUCE' { maxForks = 32 }
        }
        // Requires one shared work directory accessible from all compute nodes.
        process.stageInMode = 'symlink'
    }
    conda {
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml"
    }
}

trace {
    enabled = true
    file = 'pipeline_trace.txt'
}
report {
    enabled = true
    file = 'pipeline_report.html'
}
timeline {
    enabled = true
    file = 'pipeline_timeline.html'
}
dag {
    enabled = true
    file = 'pipeline_dag.html'
}
